# Copy file này thành .env rồi đổi giá trị trước khi chạy `docker-compose up -d`.
# Không commit file .env thật (đã có trong .gitignore).

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes-long

# Tùy chọn - dùng cho tính năng sinh câu ví dụ AI trong quiz trắc nghiệm (mục /quiz).
# Để trống thì quiz vẫn chạy bình thường, chỉ không có câu ngữ cảnh JLPT.
# Lấy key tại https://aistudio.google.com/apikey
# Có thể khai báo nhiều key, phân tách bằng dấu phẩy (không có khoảng trắng) - backend dùng luân phiên
# và tự chuyển key khi một key hết hạn mức. Hạn mức miễn phí tính theo PROJECT, nên các key cần
# thuộc các project khác nhau thì mới cộng dồn được hạn mức.
GEMINI_API_KEY=

# Trần số request Gemini mỗi ngày cho cả hệ thống. Vượt trần thì trắc nghiệm vẫn chạy, chỉ không sinh câu ví dụ mới
# cho tới ngày hôm sau (tính theo giờ UTC). Đặt 0 để bỏ giới hạn.
GEMINI_DAILY_LIMIT=100

# Đặt false khi đưa app lên mạng để người lạ không tự tạo tài khoản được.
REGISTRATION_ENABLED=true

# Sao lưu database tự động (service db-backup). Mặc định lưu vào thư mục ./backups của dự án.
# Nên trỏ BACKUP_DIR tới một thư mục được đồng bộ lên cloud (OneDrive, Google Drive...) để còn bản sao
# khi hỏng máy, ví dụ: BACKUP_DIR=C:/Users/<tên-bạn>/OneDrive/KanjiBackups
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
# Số bản backup thường được giữ lại (bản có nhãn, tạo bằng tay, không bao giờ bị xoá tự động).
BACKUP_KEEP=14
